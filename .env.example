# Copie para .env e ajuste os valores. O .env não é versionado.

# MySQL (container do docker-compose)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Porta exposta no host (3307 evita conflito com um MySQL local na 3306)
MYSQL_HOST_PORT=

# Banco usado pela aplicação rodando local (./mvnw spring-boot:run). H2 em memória por padrão.
# Rodando via docker-compose, o compose sobrescreve com o MySQL acima.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT: segredo em base64 com >= 48 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=

# Admin inicial (criado só se ainda não existir nenhum ROLE_ADMIN)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
