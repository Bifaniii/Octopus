# Copie para .env e ajuste os valores. O .env não é versionado.

# Precisa ser IGUAL ao JWT_SECRET do octopus-msusuario, senão o token dele é rejeitado aqui.
# Base64 com >= 48 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# Endereço de cada módulo de onde vêm os dados (rodando local, as portas padrão de cada um).
MS_USUARIO_URL=http://localhost:8080
MS_BAIAS_URL=http://localhost:8081
MS_MEDICACOES_URL=http://localhost:8082
MS_INTERNACAO_URL=http://localhost:8083
MS_DOSES_URL=http://localhost:8085
