# Copie para .env e preencha. O .env não é versionado.

# MySQL deste módulo (container do docker-compose)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Porta exposta no host; 3308 evita conflito com um MySQL local ou com o de outro módulo
MYSQL_HOST_PORT=
APP_PORT=

# Banco usado rodando local com ./mvnw spring-boot:run (fora do compose).
# Ex.: jdbc:mysql://localhost:3308/<MYSQL_DATABASE>
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Mesmo segredo do octopus-msusuario: é ele quem emite o token, este módulo só valida.
# base64 com >= 48 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=
