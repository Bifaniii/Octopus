# Copie para .env e ajuste os valores. O .env não é versionado.

# MySQL (container do docker-compose deste módulo)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Porta exposta no host (3307, 3308 e 3309 já são do usuário, baias e medicações)
MYSQL_HOST_PORT=3311

# Banco usado pela aplicação rodando local (./mvnw spring-boot:run).
# Ex.: jdbc:mysql://localhost:3311/<MYSQL_DATABASE>. Rodando via compose, ele sobrescreve.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Precisa ser IGUAL ao JWT_SECRET do octopus-msusuario, senão o token dele é rejeitado aqui.
# Base64 com >= 48 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=

# Endereço do ms-internacao (local: http://localhost:8083).
MS_INTERNACAO_URL=

# Endereço do octopus-msmedications (local: http://localhost:8082).
MS_MEDICACOES_URL=
